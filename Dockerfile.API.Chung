FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY QuanLyNganQuyCaNhan/QuanLyNganQuyCaNhan.API.csproj ./QuanLyNganQuyCaNhan/
COPY QuanLyNganQuyCaNhan.BLL/QuanLyNganQuyCaNhan.BLL.csproj ./QuanLyNganQuyCaNhan.BLL/
COPY QuanLyNganQuyCaNhan.DAL/QuanLyNganQuyCaNhan.DAL.csproj ./QuanLyNganQuyCaNhan.DAL/
COPY QuanLyNganQuyCaNhan.API.Shared/QuanLyNganQuyCaNhan.API.Shared.csproj ./QuanLyNganQuyCaNhan.API.Shared/

RUN dotnet restore ./QuanLyNganQuyCaNhan/QuanLyNganQuyCaNhan.API.csproj

COPY QuanLyNganQuyCaNhan/ ./QuanLyNganQuyCaNhan/
COPY QuanLyNganQuyCaNhan.BLL/ ./QuanLyNganQuyCaNhan.BLL/
COPY QuanLyNganQuyCaNhan.DAL/ ./QuanLyNganQuyCaNhan.DAL/
COPY QuanLyNganQuyCaNhan.API.Shared/ ./QuanLyNganQuyCaNhan.API.Shared/

RUN dotnet publish ./QuanLyNganQuyCaNhan/QuanLyNganQuyCaNhan.API.csproj -c Release -o /app/publish --no-restore -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_HTTP_PORTS=8080
ENV TZ=Asia/Bangkok

COPY --from=build /app/publish .

USER app
EXPOSE 8080

ENTRYPOINT ["dotnet", "QuanLyNganQuyCaNhan.API.dll"]